# oci-a1-launch.sh 설정 — 이 파일을 oci-a1.env로 복사한 뒤 값을 채우세요.
# oci-a1.env는 커밋하지 마세요 (.gitignore에 등록됨).
# OCID는 OCI 콘솔에서 복사: https://cloud.oracle.com

# 필수
COMPARTMENT_OCID="ocid1.tenancy.oc1..xxxxx"        # 루트 구획이면 테넌시 OCID
SUBNET_OCID="ocid1.subnet.oc1.ap-seoul-1.xxxxx"    # 공용 서브넷
IMAGE_OCID="ocid1.image.oc1.ap-seoul-1.xxxxx"      # aarch64 이미지 (Ubuntu 24.04 Minimal aarch64 권장)
SSH_PUB_KEY_FILE="~/.ssh/id_ed25519.pub"

# 선택 (기본값 있음)
#DISPLAY_NAME="gift-annuity-a1"
#OCPUS=2            # 무료 최대 2 (2026-06-15부터 반감, 기존 A1 자원과 합산)
#MEMORY_GB=12      # 무료 최대 12 (2026-06-15부터 반감)
#BOOT_VOLUME_GB=50
#TRY_INTERVAL=90    # 재시도 간격(초) — 60 미만 금지
#MAX_TRIES=0        # 0 = 무제한
